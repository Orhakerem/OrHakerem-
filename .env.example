# Email Configuration
RESEND_API_KEY=your_resend_api_key
RECIPIENT_EMAIL=keremliving@gmail.com
# Verified-domain sender email used only by the admin invoice/devis flow.
RESEND_INVOICE_FROM_EMAIL=invoice@orhakerem.com

# Next.js Configuration
NEXT_TELEMETRY_DISABLED=1

# Supabase Configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only admin key for admin pricing/quote-history writes.
# Preferred for new Supabase projects. Never expose this as NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=
# Legacy fallback if SUPABASE_SECRET_KEY is not available.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Vercel Cron (auto-generated by Vercel, keep-alive ping)
CRON_SECRET=

# Admin back office authentication (all three required for /admin access).
# ADMIN_PASSWORD_SHA256: sha256 hex of the admin password, e.g.
#   node -e "console.log(require('crypto').createHash('sha256').update('YOUR_PASSWORD').digest('hex'))"
# ADMIN_SESSION_SECRET: random secret (32+ bytes), e.g. openssl rand -hex 32.
# Rotating the secret invalidates every existing admin session cookie.
ADMIN_EMAIL=keremliving@gmail.com
ADMIN_PASSWORD_SHA256=
ADMIN_SESSION_SECRET=
